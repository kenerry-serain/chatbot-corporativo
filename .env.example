# Identidade visual
VITE_APP_NAME=AutoAtende

# Amazon Cognito (use um App Client público, sem client secret)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_NmJrrBb9C
VITE_COGNITO_USER_POOL_CLIENT_ID=5veai1ovoolobms7folct8n0tp

# WebSocket (opcional enquanto o backend não existe)
VITE_WEBSOCKET_URL=wss://seu-id.execute-api.us-east-1.amazonaws.com/prod
VITE_WEBSOCKET_ACTION=sendMessage
# Nome do parâmetro da URL; o valor é o access token obtido da sessão Cognito após o login
VITE_WEBSOCKET_TOKEN_QUERY_PARAM=token

# Desative em produção quando Cognito e WebSocket estiverem configurados
VITE_ENABLE_DEMO_MODE=true
