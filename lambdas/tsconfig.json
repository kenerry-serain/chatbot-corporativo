{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "aws-lambda"]
  },
  "include": ["*.ts", "authorizer/**/*.ts", "connect/**/*.ts", "disconnect/**/*.ts", "message-persist/**/*.ts", "message-processor/**/*.ts"]
}
